# =========================
# TTM369 Bot A Environment
# Copy this file to .env and fill real values on the server.
# NEVER commit real .env.
# =========================

# Bybit
BYBIT_API_KEY=CHANGE_ME
BYBIT_API_SECRET=CHANGE_ME
BYBIT_ENV=mainnet

# Telegram
TELEGRAM_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# Auto trade
AUTO_TRADE_ENABLED=true
AUTO_TRADE_MODE=MEDIUM
AUTO_TRADE_CLASSES=CORE,MEDIUM

# Trading limits
MAX_TRADES_PER_HOUR=3
MAX_CONCURRENT_TRADES=6
MAX_OPEN_POSITIONS=6
SIGNAL_MAX_AGE_SEC=120
MAX_PRICE_DEV_PCT=1.0

# Position sizing / risk
RISK_MODE=true
RISK_PER_TRADE_PCT=1.5
MAX_TOTAL_RISK_PCT=10
ACCOUNT_BALANCE_USDT=CHANGE_ME

# Notional caps
FIXED_NOTIONAL_USDT=50
MAX_NOTIONAL_HIGH=150
MAX_NOTIONAL_MEDIUM=75
MAX_NOTIONAL_HIGH_MAJOR=150
MAX_NOTIONAL_MEDIUM_MAJOR=75
MAJOR_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Exits
TRAILING_STOP_PCT=0.006
